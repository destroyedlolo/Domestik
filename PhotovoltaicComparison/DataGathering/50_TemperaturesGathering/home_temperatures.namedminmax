-->> desc=Aggregate values to save disc space.
--
-->> group=Températures
-->> listen=CombleTemperature
-->> listen=ExterieurTemperature
--->> need_topic=HomeTemperatures
--->> quiet

-- Extract probe name

MAJORDOME_TOPIC = MAJORDOME_TOPIC ..'/'
local tbl =  {MAJORDOME_TOPIC:match((MAJORDOME_TOPIC:gsub("[^/]*/", "([^/]*)/")))}
local name = tbl[ #tbl ]

-- Has we are receiving only the values we are looking for, no need for
-- additionnal processing

return name
