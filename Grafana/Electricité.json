                        "rawQuery": true,
                        "rawSql": "SELECT\n  sample_time, value, metric\nFROM (\n  SELECT\n    sample_time,\n    value - LAG(value) OVER (PARTITION BY counter, figure ORDER BY sample_time) AS value,\n  CASE \n    WHEN counter = 'Production' THEN 'Production'\n    WHEN counter = 'AutoConso' THEN 'AutoConso'\n    ELSE 'Consommation ' || figure \n  END AS metric\n  FROM electricity_counter\n  WHERE \n    (\n      (counter = 'Consommation' AND figure IN ('HC', 'HP')) \n      OR counter IN ('Production', 'AutoConso')\n    )\n    AND sample_time >= $__timeFrom() AND sample_time <= $__timeTo()\n) sub\nWHERE value < 1500 AND value > 0",
